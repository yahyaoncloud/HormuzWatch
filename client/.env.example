# ---------------------------------------------------------------------------
# HormuzWatch Client Environment Variables
# ---------------------------------------------------------------------------
# NOTE: All variables prefixed with VITE_ are bundled into the client build
# and exposed to the browser. NEVER put server-side private secrets here.
# ---------------------------------------------------------------------------

# ── API & Services ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:10020
VITE_API_TIMEOUT_MS=5000
VITE_ML_SERVICE_URL=http://localhost:8090
VITE_WS_TELEMETRY_URL=ws://localhost:10020/ws/stream
VITE_SSE_TRACES_URL=http://localhost:10020/public/stream

# ── Supabase Auth (Public Anon Key only) ──────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# ── Basemap & Tile Configuration (Zero API Key / Production Ready) ─────────
# Primary dark tactical basemap (ESRI World Dark Gray Canvas)
VITE_MAP_TILE_URL_DARK=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}

# Satellite reconnaissance basemap (ESRI World Imagery)
VITE_MAP_TILE_URL_SATELLITE=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Primary light basemap (ESRI World Light Gray Canvas)
VITE_MAP_TILE_URL_LIGHT=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}

# Fallback basemap (OSM with tactical shader grading)
VITE_MAP_TILE_URL_FALLBACK=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Subdomains for load rotation
VITE_MAP_SUBDOMAINS=abcd

# Map attribution HTML/text
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.esri.com" target="_blank" rel="noopener noreferrer">Esri</a> &mdash; National Geographic, DeLorme, NAVTEQ, OpenStreetMap

# Optional public client API key (if using a custom tile provider)
VITE_MAP_API_KEY=

# ── Feature Flags ─────────────────────────────────────────────────────────
VITE_FEATURE_WS=true
VITE_FEATURE_SSE=true
VITE_FEATURE_DATASETS=true
