PORT=10000
AUTH_DISABLED=false

# --- Single secure admin (env-driven; NOT hardcoded in source) ---
# Only an account whose email matches PRIMARY_ADMIN_EMAIL is ever granted the
# "admin" role. Every other registration is a pending, non-admin account.
PRIMARY_ADMIN_EMAIL=ykinwork1@gmail.com
PRIMARY_ADMIN_USERNAME=ykinwork1
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
JWT_SECRET=change-me-in-production
# Unified ML service (merged ml-service + ml-inference). Local docker default:
ML_SERVICE_URL=http://localhost:8090
ALLOWED_ORIGINS=https://your-static-web-app.azurestaticapps.net

AISSTREAM_API_KEY=
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
FIRMS_MAP_KEY=

# --- Kystverket open AIS feed (Norwegian EEZ; no auth, plain TCP) ---
# Raw NMEA-0183 AIS stream at IP:port. Override only if Kystverket changes the
# endpoint. The feed is enabled/disabled at runtime via the kystverket_enabled
# settings toggle (default off — opt-in), OR by setting KYSTVERKET_ENABLED=true
# (useful when the Settings UI is unavailable).
KYSTVERKET_HOST=153.44.253.27:5631
# KYSTVERKET_ENABLED=true

# --- gRPC ML transport (Go server -> Python ml-service) ---
ML_SERVICE_ADDR=localhost:8090
ML_SERVICE_TLS=off
# ML_SERVICE_CA_CERT=/path/to/ca.pem
# ML_SERVICE_TLS_CERT=/path/to/client.crt
# ML_SERVICE_TLS_KEY=/path/to/client.key

# --- Dataset pipeline (queue-based GDrive persistence) ---
# Drive folder id for the `dataset` folder (created under /Projects/HormuzWatch)
GDRIVE_DATASET_FOLDER_ID=1f3WxJ3BhHBdyOeQWRYF6kGR5v5DUGngu
# Service-account JSON key (path OR inline). If unset, uploads spill locally.
# GDRIVE_SERVICE_ACCOUNT_JSON=/secrets/gdrive-sa.json
# GDRIVE_SERVICE_ACCOUNT_JSON_INLINE={...}
DATASET_RETENTION=3
DATASET_QUEUE_SIZE=64
# Maximum rows per curated domain export.
DATASET_ROW_LIMIT=5000
# Set a positive number to schedule vessel, aircraft, and heatmap snapshots.
# Leave at 0 (or unset) for API-triggered snapshots only.
DATASET_SNAPSHOT_INTERVAL_MINUTES=0

# Metrics API key (also gates POST /datasets/* write endpoints)
METRICS_API_KEY=
