# HormuzWatch Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your actual values.
# .env is git-ignored; this .env.example is the only committed reference.
#
# ── Quick start ─────────────────────────────────────────────────────────
#   cp .env.example .env
#   # Edit .env with your real keys, then:
#   npm run dev
# ────────────────────────────────────────────────────────────────────────

# ============================================================
# Go Backend API
# ============================================================

# REST API base URL (no trailing slash)
VITE_API_URL=http://localhost:10020
# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=5000

# ============================================================
# WebSocket (live telemetry)
# ============================================================

VITE_WS_TELEMETRY_URL=ws://localhost:10020/ws/stream
VITE_WS_RECONNECT_INITIAL_MS=1000
VITE_WS_RECONNECT_MAX_MS=30000
VITE_WS_MAX_RECONNECT=10

# ============================================================
# Server-Sent Events (public traces)
# ============================================================

VITE_SSE_TRACES_URL=http://localhost:10020/public/stream
VITE_SSE_RECONNECT_MS=3000

# ============================================================
# Supabase (auth & data)
# ============================================================
# Get these from your Supabase dashboard → Settings → API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# Maps
# ============================================================

# MapLibre style JSON (leave empty to use bundled /map-styles/hormuz-dark.json)
VITE_MAP_STYLE_URL=
# Raster tile server URL (XYZ template)
VITE_MAP_TILES_URL=

# ============================================================
# Feature Flags
# ============================================================

# Enable WebSocket telemetry stream (true/false)
VITE_FEATURE_WS=true
# Enable SSE traces stream (true/false)
VITE_FEATURE_SSE=true
# Enable admin dataset management (true/false)
VITE_FEATURE_DATASETS=true

# ============================================================
# Observability (optional)
# ============================================================

# Sentry DSN for error tracking
VITE_SENTRY_DSN=
# Google Analytics measurement ID
VITE_ANALYTICS_ID=

# ============================================================
# App Metadata (auto-populated at build time)
# ============================================================

VITE_APP_VERSION=2.0.0
VITE_BUILD_TIME=
